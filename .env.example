# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://cdc:replace-with-local-password@localhost:5432/cdc_workspace?schema=public"
POSTGRES_USER="cdc"
POSTGRES_PASSWORD="replace-with-local-password"
POSTGRES_DB="cdc_workspace"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
ALLOWED_GITHUB_USER_ID="248133835"

# Optional public portfolio link. For a local portfolio preview on port 3100,
# point this to http://localhost:3000/login while the SSH tunnel is active.
# For a future split-domain release, use the approved private site login URL.
NEXT_PUBLIC_PRIVATE_WORKSPACE_URL=""

# Optional, server-side only. Use a separate credential limited to public data,
# without read:user or private repository access. The portfolio falls back to
# a GitHub profile link when unset or when the API cannot be reached.
PORTFOLIO_GITHUB_PUBLIC_TOKEN=""

# Required only when enabling public portfolio visit counting. Generate a new
# random 32+ character secret for each environment; never reuse a business token.
PORTFOLIO_ANALYTICS_SECRET=""

# Public legal and launch metadata, read by the server at runtime. Use the
# approved filing details and the actual first public opening time only.
SITE_ICP_NUMBER=""
SITE_ICP_NAME=""
SITE_POLICE_NUMBER=""
PORTFOLIO_LAUNCHED_AT=""
