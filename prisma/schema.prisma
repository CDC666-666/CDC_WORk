  @@unique([workspaceId, id])
  @@index([workspaceId])
}

model ContentState {
  id               String    @id
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  payload          Json
  sourceHash       String
  migrationBatchId String
  relationRefs     Json
  status           String?
  isFavorite       Boolean?
  isInKnowledgeBase Boolean?
  isInStudyPlan    Boolean?

  @@unique([workspaceId, id])
  @@index([workspaceId])
}

model MigrationBatch {
  id                String @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceFingerprint String
  planFingerprint   String
  sourceKind        String
  status            String
  rawSource         Json
  sourceCounts      Json
  result            Json?
  issues            Json?
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  @@unique([workspaceId, sourceFingerprint, planFingerprint])
  @@index([workspaceId, status])
}

model MigrationEntityMap {
  id              String @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  collection      String
  sourceId        String
  targetModel     String
  targetId        String
  sourceHash      String
  serverVersion   Int?
  serverUpdatedAt DateTime?
  batchId         String
  createdAt       DateTime @default(now())

  @@unique([workspaceId, collection, sourceId])
  @@index([workspaceId, batchId])
}

model MigrationPending {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  batchId     String
  collection  String
  sourceId    String
  sourceOrdinal Int
  payload     Json
  sourceHash  String
  reasons     Json

  @@unique([batchId, collection, sourceId, sourceOrdinal])
  @@index([workspaceId, collection])
}
