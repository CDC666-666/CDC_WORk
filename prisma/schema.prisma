  id               String    @id
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  payload          Json
  sourceHash       String
  migrationBatchId String
  relationRefs     Json
  amount           Decimal? @db.Decimal(20, 2)
