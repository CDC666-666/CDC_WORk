{
  "name": "cdc-ai-workspace",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/workspace-calendar.test.ts tests/repository-data.test.ts tests/domain-persistence.test.ts tests/academic-flow.test.ts tests/reflections-flow.test.ts tests/server/auth-policy.test.ts tests/server/auth-logging.test.ts tests/server/review-domain.test.ts tests/migration-dependencies.test.ts tests/engineering-experience.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 tests/browser/migration-preservation.test.ts tests/browser/engineering-experience-navigation.test.ts tests/browser/engineering-experience-project.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/server/database-flow.test.ts tests/server/migration-flow.test.ts tests/server/daily-entity-flow.test.ts tests/server/linked-accumulation-concurrency.test.ts tests/server/experience-flow.test.ts tests/server/auth-configuration.test.ts",
    "test:api": "tsx --test tests/server/http-flow.test.ts tests/server/experience-http.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "import:experience": "node --conditions=react-server --import tsx scripts/import-auto-aim-experience.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "next-auth": "4.24.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.24",
    "playwright": "1.56.1",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "sharp": "0.35.4"
  }
}
